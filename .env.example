# Default local LLM model (Llama 3 8B - Meta)
DEFAULT_MODEL="llama3:latest"

# Alternative local LLM model (Code Llama 7B - Meta Code-specialized)
ALTERNATIVE_MODEL="codellama:latest"

# Ollama local daemon endpoint (Ollama 0.40.13 API: GET /api/tags, POST /api/generate)
OLLAMA_BASE_URL="http://localhost:11434"

# Generation request timeout in seconds
REQUEST_TIMEOUT_SECONDS="120.0"

# Application URL
APP_URL="http://localhost:3000"
